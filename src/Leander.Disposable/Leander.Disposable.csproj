<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Leander.Disposable</PackageId>
    <Version>1.0.0</Version>
    <Authors>Leander Tilsted Jul Withen</Authors>
    <Description>A small .NET utility library for composing and managing disposable resources without writing boilerplate classes.</Description>
    <PackageTags>disposable;idisposable;iasyncdisposable;resource-management</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/LeanderTilstedJulWithen/Leander.Disposable</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
